{
  "version": 2,
  "crons": [
    {
      "path": "/api/admin/check-daily-sales",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/admin/check-daily-sales",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
